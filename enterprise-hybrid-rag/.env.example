# Copy to .env and fill in what you need. .env is gitignored; never commit it.
#
#   cp .env.example .env
#
# Nothing here is required to run the project. With an empty file the system
# still works: it falls back to backends that need no network and no key, and
# reports which ones it chose in GET /health and in every evaluation artefact.

# ---------------------------------------------------------------- embeddings
# No API key is needed. all-MiniLM-L6-v2 is a public model; `auto` downloads it
# on first use and caches it. It only falls back to tfidf_svd when the hub is
# unreachable — check /health to see which one you actually got.
#   auto | sentence_transformers | tfidf_svd
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ----------------------------------------------------------------- reranking
# Also public, also no key.
#   auto | cross_encoder | lexical | none
RERANKER_BACKEND=auto
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ----------------------------------------------------------------------- LLM
# THIS is the one that actually needs a key. Without it the answer layer falls
# back to `extractive`, which selects supporting sentences from the retrieved
# context and cites them. That is real, and useful for evaluating retrieval,
# but it is not a generative model and is never reported as one.
#
#   auto | openai_compatible | anthropic | extractive
LLM_PROVIDER=auto

# --- Option A: OpenAI, or anything speaking the same API (vLLM, Ollama,
# --- Together, Groq, an Azure-style gateway). Point LLM_BASE_URL at it.
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# --- Option B: Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# --- Option C: Ollama, or any local OpenAI-compatible server. No key, no cost,
# --- and no document text leaves the machine — which is usually the point when
# --- the corpus is internal policy and contracts.
#
#     ollama pull llama3.1
#     ollama serve
#
# LLM_API_KEY must be set to something non-empty even though Ollama ignores it:
# the client refuses to start without one rather than sending unauthenticated
# requests to what it believes is a hosted provider. Any placeholder works.
#
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama
#
# From inside Docker, localhost is the container, not your machine. Use:
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
# and on Linux add to the api service in docker-compose.yml:
#   extra_hosts:
#     - "host.docker.internal:host-gateway"

# ------------------------------------------------------------------ chunking
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=100

# ----------------------------------------------------------------- retrieval
#   dense | sparse | hybrid
RETRIEVAL_METHOD=hybrid
RRF_K=60
RERANK_TOP_K=5

# ----------------------------------------------------------------- abstention
# Turn this off and the system will answer every question, including the ones
# the corpus cannot support. Leave it on.
NO_ANSWER_ENABLED=true

# -------------------------------------------------------------- observability
LOG_LEVEL=INFO
LOG_JSON=true
# Indexed documents are usually confidential. Leave this false unless you are
# debugging locally and understand that chunk text will reach your log stack.
LOG_CHUNK_TEXT=false
